{
"position":"top",
"margin-top":8,
"margin-left":10,
"margin-right":10,

"modules-left":[
"mango/workspaces"
],

"modules-center":[
"clock"
],

"modules-right":[
"temperature",
"memory",
"battery"
],

"temperature": {
  "format": " {temperatureC}°C",
  "critical-threshold": 79,
  "format-critical": " {temperatureC}°C"
},

"battery": {
    "interval": 10,
    "states": {
        "warning": 30,
        "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
    ],
    "tooltip-format": "{timeTo} rimanenti"
},

"mango/workspaces": {
     "format": "{icon}",
     "format-icons": {
	"1": "一",
	"2": "二",
	"3": "三",
	"4": "四",
	"5": "五",
	"6": "六",
	"7": "七",
	"8": "八",
	"9": "九",
	"10": "十",
	"default": "",
	"urgent": "！"
     },
     "hide-empty": true,
     "on-click": "activate",
     "on-click-right": "toggle",
     "overview-label": "OVERVIEW",
 },
}
